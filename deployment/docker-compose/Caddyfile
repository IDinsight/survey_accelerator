{$DOMAIN:localhost} {
    # MCP endpoint, so Claude connectors point at https://<domain>/mcp rather
    # than the /api-prefixed form. flush_interval disables response buffering,
    # which the streamable HTTP transport needs when it streams over SSE.
    # OAuth discovery probes must 404 rather than fall through to the catch-all,
    # which would answer them with the React app under a 200 and leave a client
    # trying to parse HTML as metadata. The MCP endpoint implements no OAuth.
    handle /.well-known/oauth-* {
        respond 404
    }

    handle /mcp* {
        # The transport is mounted at /mcp/ and a bare /mcp would otherwise be
        # answered with a 307 that some MCP clients drop the POST body on.
        rewrite /mcp /mcp/
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }

    # Route API requests to the backend
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend:8000
    }
    
    # Route PDF requests to the backend
    handle /pdf/* {
        reverse_proxy backend:8000
    }

    # Catch-all for all other requests to the frontend
    handle {
        reverse_proxy frontend:3000
    }
}
