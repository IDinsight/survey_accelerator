POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres  #pragma: allowlist secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres

PROMETHEUS_MULTIPROC_DIR="/tmp"
BACKEND_API_URL="https://survey.idinsight.io/api"

# MCP server (exposed at /mcp for Claude connectors)
MCP_ENABLED=1
# Shared bearer token. Leave unset to run the endpoint with no authentication.
MCP_API_KEY=
# Results per search. Each result costs two LLM calls, so raising these makes
# searches slower and more expensive.
MCP_DEFAULT_MAX_RESULTS=10
MCP_MAX_RESULTS_LIMIT=25
# Character budget before get_document_text paginates.
MCP_MAX_TEXT_CHARS=40000
